# Copy to .env.local for local development; set the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server-only; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: email a notification for every new inquiry (https://resend.com)
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=
INQUIRY_FROM_EMAIL=EllaCare Website <onboarding@resend.dev>

NEXT_PUBLIC_SITE_URL=https://ellacare.com
